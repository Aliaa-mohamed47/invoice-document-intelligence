# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS (required for S3 storage & EC2 deployment) ───────────────────────────
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_REGION=us-east-1

# ── S3 bucket for invoice file uploads ───────────────────────────────────────
S3_BUCKET=invoice-intelligence-bucket

# ── Database (SQLite for local/demo — no credentials needed) ─────────────────
# If you switch to PostgreSQL on AWS RDS, set these:
# DB_URL=jdbc:postgresql://<host>:5432/invoicedb
# DB_USERNAME=postgres
# DB_PASSWORD=your_password_here

# ── Model path (inside inference-api container) ───────────────────────────────
MODEL_PATH=/app/ai/model/saved_model

# ── Service URLs (used internally by docker-compose network) ─────────────────
# These are already set correctly in docker-compose.yml.
# Override here only if running services outside Docker.
# INFERENCE_API_URL=http://localhost:8000
